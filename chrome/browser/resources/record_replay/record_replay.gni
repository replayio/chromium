# List of files that don't need to be passed to html_to_wrapper().
non_web_component_files =
    [
      "auth.ts",
      "record_replay.ts",
      "record_replay_api.ts",
    ]

ts_files = non_web_component_files
# The generated bindings are TypeScript: the fork's mojom target defines webui_module_path,
# and mojom.gni sets use_typescript_for_target from exactly that. So the INPUT to ts_library is
# the .ts the generator emits, while the names below with a .js extension are what tsc EMITS
# into $target_gen_dir/tsc and are what the grd and the optimize_webui bundle refer to.
mojo_ts_files = [ "record_replay_manager.mojom-webui.ts" ]
mojo_js_files = [ "record_replay_manager.mojom-webui.js" ]
